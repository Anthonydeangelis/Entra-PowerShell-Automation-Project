# Inactive showcase copy; see ../README.md before adapting.
name: Deploy Azure Runbooks

on:
  workflow_dispatch:
  push:
    branches: [main]
    paths:
      - 'runbooks/*.ps1'
      - '.github/workflows/test-azure-login.yml'

permissions:
  id-token: write
  contents: read

concurrency:
  group: deploy-azure-runbooks
  cancel-in-progress: false

jobs:
  deploy:
    if: github.ref == 'refs/heads/main'
    runs-on: ubuntu-latest
    timeout-minutes: 15
    env:
      SUBSCRIPTION_ID: ${{ secrets.AZURE_SUBSCRIPTION_ID }}
      RESOURCE_GROUP: YOUR_RESOURCE_GROUP
      AUTOMATION_ACCOUNT: YOUR_AUTOMATION_ACCOUNT
      RUNTIME: YOUR_RUNTIME_ENVIRONMENT

    steps:
      - name: Download repository
        uses: actions/checkout@v4
        with:
          persist-credentials: false

      - name: Validate PowerShell syntax without executing scripts
        shell: pwsh
        run: |
          $files = @(Get-ChildItem ./runbooks -Filter *.ps1 -File)
          if ($files.Count -eq 0) { throw 'No runbooks found.' }
          foreach ($file in $files) {
              if ($file.BaseName -notmatch '^[a-zA-Z][a-zA-Z0-9_-]*$') {
                  throw "Invalid runbook name: $($file.BaseName)"
              }
              $tokens = $null
              $parseErrors = $null
              $null = [System.Management.Automation.Language.Parser]::ParseFile(
                  $file.FullName, [ref]$tokens, [ref]$parseErrors)
              if ($parseErrors.Count -gt 0) {
                  throw "Syntax errors in $($file.Name): $($parseErrors.Message -join '; ')"
              }
          }

      - name: Sign in to Azure
        uses: azure/login@v3
        with:
          client-id: ${{ secrets.AZURE_CLIENT_ID }}
          tenant-id: ${{ secrets.AZURE_TENANT_ID }}
          subscription-id: ${{ secrets.AZURE_SUBSCRIPTION_ID }}

      # Disable built-in source-control Auto Sync before enabling this workflow.
      # Publishing replaces code used by future jobs, including scheduled jobs.
      # This workflow never starts a runbook job or deletes an Azure runbook.
      - name: Upload and publish runbooks
        shell: bash
        run: |
          set -euo pipefail
          : "${SUBSCRIPTION_ID:?AZURE_SUBSCRIPTION_ID secret is missing}"
          api="2024-10-23"
          base="https://management.azure.com/subscriptions/$SUBSCRIPTION_ID/resourceGroups/$RESOURCE_GROUP/providers/Microsoft.Automation/automationAccounts/$AUTOMATION_ACCOUNT"

          location=$(az rest --method get \
            --url "$base?api-version=$api" \
            --query location --output tsv)

          az rest --method get \
            --url "$base/runtimeEnvironments/$RUNTIME?api-version=$api" \
            --output none

          shopt -s nullglob
          files=(runbooks/*.ps1)
          if [ "${#files[@]}" -eq 0 ]; then
            echo "No PowerShell runbooks found."
            exit 1
          fi

          for file in "${files[@]}"; do
            name=$(basename "$file" .ps1)
            url="$base/runbooks/$name"
            echo "Deploying $name using $RUNTIME"

            body=$(jq -n \
              --arg location "$location" \
              --arg runtime "$RUNTIME" \
              '{location: $location, properties: {
                runbookType: "PowerShell",
                runtimeEnvironment: $runtime,
                draft: {}
              }}')

            az rest --method put \
              --url "$url?api-version=$api" \
              --body "$body" --output none

            az rest --method put \
              --url "$url/draft/content?api-version=$api" \
              --headers "Content-Type=text/plain; charset=utf-8" \
              --body "@$file" --output none

            az rest --method post \
              --url "$url/publish?api-version=$api" \
              --output none

            verified=false
            for attempt in {1..30}; do
              result=$(az rest --method get --url "$url?api-version=$api")
              state=$(jq -r '.properties.state' <<< "$result")
              runtime=$(jq -r '.properties.runtimeEnvironment' <<< "$result")
              if [[ "$state" == "Published" && "$runtime" == "$RUNTIME" ]]; then
                verified=true
                break
              fi
              sleep 5
            done

            if [[ "$verified" != true ]]; then
              echo "Publishing/runtime verification failed for $name."
              exit 1
            fi
            echo "Published and verified: $name"
          done
